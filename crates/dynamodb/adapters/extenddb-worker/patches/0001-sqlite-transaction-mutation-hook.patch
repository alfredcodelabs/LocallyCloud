diff --git a/crates/storage-sqlite/src/mutation_hook.rs b/crates/storage-sqlite/src/mutation_hook.rs
new file mode 100644
index 0000000..35dc29b
--- /dev/null
+++ b/crates/storage-sqlite/src/mutation_hook.rs
@@ -0,0 +1,110 @@
+// Copyright 2026 LocalCloud contributors
+// SPDX-License-Identifier: Apache-2.0
+
+//! Optional transaction-local mutation observer; absent by default.
+use crate::SqliteEngine;
+use extenddb_core::expression::ExpressionMaps;
+use extenddb_core::types::{Item, TableKeyInfo};
+use extenddb_storage::{StreamCapture, error::StorageError};
+use futures::future::BoxFuture;
+use sqlx::{Sqlite, Transaction};
+use std::sync::Arc;
+
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub enum MutationDecision {
+    Apply,
+    Skip,
+}
+
+pub struct Mutation<'a> {
+    pub key_info: &'a TableKeyInfo,
+    pub key: &'a Item,
+    pub old: Option<&'a Item>,
+    pub new: Option<&'a Item>,
+    pub context: Option<&'a serde_json::Value>,
+}
+
+pub trait MutationHook: Send + Sync {
+    fn capture<'a, 'c>(
+        &'a self,
+        tx: &'a mut Transaction<'c, Sqlite>,
+        mutation: Mutation<'a>,
+    ) -> BoxFuture<'a, Result<MutationDecision, StorageError>>;
+}
+
+impl SqliteEngine {
+    pub fn install_mutation_hook(&self, hook: Arc<dyn MutationHook>) -> Result<(), StorageError> {
+        self.mutation_hook
+            .set(hook)
+            .map_err(|_| StorageError::Validation("mutation hook already installed".into()))
+    }
+
+    pub(crate) async fn capture_mutation(
+        &self,
+        tx: &mut Transaction<'_, Sqlite>,
+        key_info: &TableKeyInfo,
+        key: &Item,
+        old: Option<&Item>,
+        new: Option<&Item>,
+        context: Option<&serde_json::Value>,
+    ) -> Result<MutationDecision, StorageError> {
+        match self.mutation_hook.get() {
+            Some(hook) => {
+                hook.capture(
+                    tx,
+                    Mutation {
+                        key_info,
+                        key,
+                        old,
+                        new,
+                        context,
+                    },
+                )
+                .await
+            }
+            None => Ok(MutationDecision::Apply),
+        }
+    }
+
+    /// Apply an externally committed image through normal index/vector/stream maintenance.
+    pub async fn apply_replica_change(
+        &self,
+        key_info: &TableKeyInfo,
+        key: &Item,
+        item: Option<Item>,
+        context: &serde_json::Value,
+        stream: Option<&StreamCapture>,
+    ) -> Result<(), StorageError> {
+        if self.mutation_hook.get().is_none() {
+            return Err(StorageError::Validation(
+                "replica apply requires a mutation hook".into(),
+            ));
+        }
+        match item {
+            Some(item) => self
+                .put_item_impl(
+                    key_info,
+                    item,
+                    false,
+                    None,
+                    &ExpressionMaps::default(),
+                    stream,
+                    Some(context),
+                )
+                .await
+                .map(|_| ()),
+            None => self
+                .delete_item_impl(
+                    key_info,
+                    key,
+                    false,
+                    None,
+                    &ExpressionMaps::default(),
+                    stream,
+                    Some(context),
+                )
+                .await
+                .map(|_| ()),
+        }
+    }
+}
