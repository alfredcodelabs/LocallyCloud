+impl SqliteEngine {
+    pub async fn backup_snapshot(
+        &self,
+        account: &str,
+        arn: &str,
+    ) -> Result<Option<serde_json::Value>, StorageError> {
+        let exists: bool = sqlx::query_scalar("SELECT EXISTS(SELECT 1 FROM sqlite_master WHERE type='table' AND name='backup_table_schema')")
+            .fetch_one(&self.pool).await.map_err(|e| StorageError::Internal(e.to_string()))?;
+        if !exists {
+            return Ok(None);
+        }
+        let row: Option<(String,)> = sqlx::query_as("SELECT s.description FROM backup_table_schema s JOIN backups b ON b.backup_arn=s.backup_arn WHERE b.backup_arn=? AND b.account_id=? AND b.backup_status='AVAILABLE'")
+            .bind(arn).bind(account).fetch_optional(&self.pool).await
+            .map_err(|e| StorageError::Internal(e.to_string()))?;
+        row.map(|r| serde_json::from_str(&r.0).map_err(|e| StorageError::Internal(e.to_string())))
+            .transpose()
+    }
+
+    pub async fn list_backup_page(
+        &self,
+        account: &str,
+        table: Option<&str>,
+        start: &str,
+        lower: Option<f64>,
+        upper: Option<f64>,
+        limit: u32,
+    ) -> Result<Vec<BackupSummary>, StorageError> {
+        let limit = limit.min(101);
+        let rows: Vec<(String,String,String,String,i64,String,String)> = sqlx::query_as(
+            "SELECT b.backup_arn,b.backup_name,b.table_name,b.backup_status,b.backup_size_bytes,             'arn:aws:dynamodb:' || ? || ':' || b.account_id || ':table/' || b.table_name,b.created_at              FROM backups b WHERE b.account_id=? AND b.backup_status='AVAILABLE'              AND (? IS NULL OR b.table_name=?) AND b.backup_arn>?              AND (? IS NULL OR CAST(strftime('%s',b.created_at) AS REAL)+CAST(substr(b.created_at,21,3) AS REAL)/1000.0>=?)              AND (? IS NULL OR CAST(strftime('%s',b.created_at) AS REAL)+CAST(substr(b.created_at,21,3) AS REAL)/1000.0<?)              ORDER BY b.backup_arn LIMIT ?"
+        ).bind(&self.region).bind(account).bind(table).bind(table).bind(start)
+            .bind(lower).bind(lower).bind(upper).bind(upper).bind(i64::from(limit))
+            .fetch_all(&self.pool).await.map_err(|e| StorageError::Internal(e.to_string()))?;
+        Ok(rows
+            .into_iter()
+            .map(
+                |(arn, name, table, status, size, table_arn, created)| BackupSummary {
+                    backup_arn: arn,
+                    backup_name: name,
+                    table_name: table,
+                    backup_status: status,
+                    backup_size_bytes: size,
+                    table_arn,
+                    backup_creation_date_time: ts_to_epoch(&created),
+                    backup_type: "USER".into(),
+                },
+            )
+            .collect())
+    }
 }
 
