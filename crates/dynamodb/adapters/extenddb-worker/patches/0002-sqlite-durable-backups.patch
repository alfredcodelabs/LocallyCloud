+/// Restore builds every secondary index before publishing the restored table ACTIVE.
+pub(crate) async fn fetch_restore_indexes(
+    table_id: &str,
+    pool: &sqlx::SqlitePool,
+) -> Result<Vec<IndexMeta>, StorageError> {
+    let mut indexes = fetch_indexes_for_table(table_id, pool).await?;
+    for index in &mut indexes {
+        index.propagation_delay_ms = Some(0);
+    }
+    Ok(indexes)
 }
 
