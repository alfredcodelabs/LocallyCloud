+const BACKUP_SCHEMA: &str = "CREATE TABLE IF NOT EXISTS backup_table_schema (backup_arn TEXT PRIMARY KEY REFERENCES backups(backup_arn) ON DELETE CASCADE, description TEXT NOT NULL)";
+
+fn restore_input(
+    snapshot: &serde_json::Value,
+    target: &str,
+) -> Result<CreateTableInput, StorageError> {
+    let mut input = serde_json::json!({"TableName":target});
+    for field in [
+        "KeySchema",
+        "AttributeDefinitions",
+        "GlobalSecondaryIndexes",
+        "LocalSecondaryIndexes",
+        "OnDemandThroughput",
+    ] {
+        if let Some(value) = snapshot.get(field) {
+            input[field] = value.clone();
+        }
+    }
+    let billing = snapshot
+        .get("BillingModeSummary")
+        .and_then(|s| s.get("BillingMode"))
+        .and_then(serde_json::Value::as_str)
+        .unwrap_or("PROVISIONED");
+    input["BillingMode"] = serde_json::json!(billing);
+    if billing == "PROVISIONED" {
+        input["ProvisionedThroughput"] = snapshot
+            .get("ProvisionedThroughput")
+            .cloned()
+            .ok_or_else(|| {
+                StorageError::Unsupported("backup throughput snapshot is unavailable".into())
+            })?;
+    }
+    if let Some(class) = snapshot
+        .get("TableClassSummary")
+        .and_then(|v| v.get("TableClass"))
+    {
+        input["TableClass"] = class.clone();
+    }
+    // AWS restores neither streams, tags, TTL nor deletion protection.
+    serde_json::from_value(input).map_err(|e| StorageError::Internal(e.to_string()))
+}
