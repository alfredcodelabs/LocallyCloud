+#[cfg(test)]
+mod backup_schema_tests {
+    use super::*;
+    use serde_json::json;
+
+    #[test]
+    fn restore_keeps_indexes_and_capacity_but_does_not_copy_streams_tags_or_ttl() {
+        let snapshot = json!({"KeySchema":[{"AttributeName":"pk","KeyType":"HASH"},{"AttributeName":"sk","KeyType":"RANGE"}],
+            "AttributeDefinitions":[{"AttributeName":"pk","AttributeType":"S"},{"AttributeName":"sk","AttributeType":"S"},{"AttributeName":"group","AttributeType":"S"}],
+            "ProvisionedThroughput":{"ReadCapacityUnits":7,"WriteCapacityUnits":11,"LastIncreaseDateTime":1},
+            "GlobalSecondaryIndexes":[{"IndexName":"by-group","KeySchema":[{"AttributeName":"group","KeyType":"HASH"}],"Projection":{"ProjectionType":"ALL"},"ProvisionedThroughput":{"ReadCapacityUnits":3,"WriteCapacityUnits":4},"IndexStatus":"ACTIVE"}],
+            "LocalSecondaryIndexes":[{"IndexName":"by-local","KeySchema":[{"AttributeName":"pk","KeyType":"HASH"},{"AttributeName":"group","KeyType":"RANGE"}],"Projection":{"ProjectionType":"ALL"}}],
+            "StreamSpecification":{"StreamEnabled":true,"StreamViewType":"KEYS_ONLY"},"Tags":[{"Key":"owner","Value":"source"}],"TimeToLiveDescription":{"TimeToLiveStatus":"ENABLED"}});
+        let input = restore_input(&snapshot, "restored").unwrap();
+        assert_eq!(input.table_name, "restored");
+        assert_eq!(input.provisioned_throughput.unwrap().read_capacity_units, 7);
+        assert_eq!(
+            input.global_secondary_indexes.unwrap()[0]
+                .provisioned_throughput
+                .as_ref()
+                .unwrap()
+                .write_capacity_units,
+            4
+        );
+        assert_eq!(
+            input.local_secondary_indexes.unwrap()[0].index_name,
+            "by-local"
+        );
+        assert!(input.stream_specification.is_none());
+        assert!(input.tags.is_none());
+        assert!(input.sse_specification.is_none());
+    }
+}
