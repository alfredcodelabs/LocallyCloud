+// Copyright 2026 LocalCloud contributors
+// SPDX-License-Identifier: Apache-2.0
+
+//! Transaction-local scalar history. Official SQLite writes and restore maintain all indexes.
+use std::time::{SystemTime, UNIX_EPOCH};
+
+use extenddb_core::types::{Item, TableDescription, TableKeyInfo, TableStatus};
+use extenddb_storage::BackupEngine;
+use extenddb_storage::error::StorageError;
+use extenddb_storage::util::{parse_sk, pk_to_text, sk_column, sk_info};
+use serde_json::{Value, json};
+use sqlx::{Sqlite, SqlitePool, Transaction};
+
+use crate::backup::SnapshotData;
+use crate::data::{BoundValue, data_table_name, sk_bound};
+use crate::store::SqliteEngine;
+
+type Result<T> = std::result::Result<T, StorageError>;
+const DAY: i64 = 86_400_000_000;
+const SCHEMA: &str = "
+CREATE TABLE IF NOT EXISTS lc_pitr_clock(singleton INTEGER PRIMARY KEY CHECK(singleton=1),last_us INTEGER NOT NULL);
+INSERT OR IGNORE INTO lc_pitr_clock VALUES(1,0);
+CREATE TABLE IF NOT EXISTS lc_pitr_windows(table_id TEXT PRIMARY KEY REFERENCES tables(table_id) ON DELETE CASCADE,
+ account_id TEXT NOT NULL,table_name TEXT NOT NULL,enabled INTEGER NOT NULL,started_us INTEGER NOT NULL,floor_us INTEGER NOT NULL,days INTEGER NOT NULL CHECK(days BETWEEN 1 AND 35));
+CREATE TABLE IF NOT EXISTS lc_pitr_versions(table_id TEXT NOT NULL REFERENCES lc_pitr_windows(table_id) ON DELETE CASCADE,
+ pk TEXT NOT NULL,sk TEXT NOT NULL,at_us INTEGER NOT NULL,item_data TEXT,PRIMARY KEY(table_id,pk,sk,at_us));
+CREATE INDEX IF NOT EXISTS lc_pitr_age ON lc_pitr_versions(table_id,at_us);
+CREATE TABLE IF NOT EXISTS lc_pitr_pending(table_id TEXT NOT NULL REFERENCES lc_pitr_windows(table_id) ON DELETE CASCADE,
+ pk TEXT NOT NULL,sk TEXT NOT NULL,item_data TEXT,PRIMARY KEY(table_id,pk,sk));
+CREATE TABLE IF NOT EXISTS lc_backup_retention(backup_arn TEXT PRIMARY KEY REFERENCES backups(backup_arn) ON DELETE CASCADE,kind TEXT NOT NULL,expires_us INTEGER);
+CREATE TABLE IF NOT EXISTS lc_pitr_restore_requests(backup_arn TEXT PRIMARY KEY REFERENCES backups(backup_arn) ON DELETE CASCADE,source_arn TEXT NOT NULL,at_us INTEGER NOT NULL);
+CREATE TABLE IF NOT EXISTS lc_pitr_restores(table_id TEXT PRIMARY KEY REFERENCES tables(table_id) ON DELETE CASCADE,source_arn TEXT NOT NULL,at_us INTEGER NOT NULL);
+";
+
+pub(crate) fn storage(error: sqlx::Error) -> StorageError {
+    StorageError::Internal(error.to_string())
+}
+fn unsupported() -> StorageError {
+    StorageError::Unsupported(
+        "PITR supports only active scalar tables with default-owned encryption".into(),
+    )
+}
+fn unavailable() -> StorageError {
+    StorageError::Validation(
+        "PITR_UNAVAILABLE: Point-in-time recovery is not enabled for this table".into(),
+    )
+}
+fn invalid_time() -> StorageError {
+    StorageError::Validation(
+        "PITR_INVALID_TIME: RestoreDateTime is outside the restorable interval".into(),
+    )
+}
+pub(crate) fn now_us() -> Result<i64> {
+    SystemTime::now()
+        .duration_since(UNIX_EPOCH)
+        .map_err(|_| StorageError::Transient("PITR clock precedes the epoch".into()))?
+        .as_micros()
+        .try_into()
+        .map_err(|_| StorageError::Transient("PITR clock is out of range".into()))
+}
+#[allow(clippy::cast_precision_loss)]
+pub(crate) fn seconds(at: i64) -> f64 {
+    at as f64 / 1_000_000.0
+}
+
+fn restore_time(at: Option<f64>, now: i64, earliest: i64) -> Result<i64> {
+    let Some(at) = at else { return Ok(now) };
+    let scaled = at * 1_000_000.0;
+    if !scaled.is_finite() || scaled < 0.0 || scaled > seconds(now) * 1_000_000.0 {
+        return Err(invalid_time());
+    }
+    #[allow(clippy::cast_possible_truncation)]
+    let requested = scaled.round() as i64;
+    if requested < earliest || requested > now {
+        return Err(invalid_time());
+    }
+    Ok(requested)
+}
+
+pub(crate) async fn initialize(pool: &SqlitePool) -> Result<()> {
+    sqlx::raw_sql(SCHEMA).execute(pool).await.map_err(storage)?;
+    Ok(())
+}
+
+#[derive(sqlx::FromRow)]
+struct Window {
+    enabled: bool,
+    started_us: i64,
+    floor_us: i64,
+    days: i64,
+}
+async fn window(tx: &mut Transaction<'_, Sqlite>, id: &str) -> Result<Option<Window>> {
+    sqlx::query_as("SELECT enabled,started_us,floor_us,days FROM lc_pitr_windows WHERE table_id=?")
+        .bind(id)
+        .fetch_optional(&mut **tx)
+        .await
+        .map_err(storage)
+}
+pub(crate) async fn enabled(tx: &mut Transaction<'_, Sqlite>, table_id: &str) -> Result<bool> {
+    sqlx::query_scalar(
+        "SELECT EXISTS(SELECT 1 FROM lc_pitr_windows WHERE table_id=? AND enabled=1)",
+    )
+    .bind(table_id)
+    .fetch_one(&mut **tx)
+    .await
+    .map_err(storage)
+}
+
+async fn checked_now(tx: &mut Transaction<'_, Sqlite>) -> Result<i64> {
+    let now = now_us()?;
+    let last: i64 = sqlx::query_scalar("SELECT last_us FROM lc_pitr_clock WHERE singleton=1")
+        .fetch_one(&mut **tx)
+        .await
+        .map_err(storage)?;
+    if now < last {
+        return Err(StorageError::Transient(
+            "PITR system clock moved backwards; restore the clock and retry".into(),
+        ));
+    }
+    Ok(now)
+}
+async fn commit_stamp(tx: &mut Transaction<'_, Sqlite>) -> Result<i64> {
+    let now = checked_now(tx).await?;
+    let changed = sqlx::query("UPDATE lc_pitr_clock SET last_us=? WHERE singleton=1 AND last_us<?")
+        .bind(now)
+        .bind(now)
+        .execute(&mut **tx)
+        .await
+        .map_err(storage)?;
+    if changed.rows_affected() != 1 {
+        return Err(StorageError::Transient(
+            "PITR commit clock has not advanced; retry the write".into(),
+        ));
+    }
+    Ok(now)
+}
+fn floor(window: &Window, now: i64) -> i64 {
+    window
+        .started_us
+        .max(window.floor_us)
+        .max(now - window.days * DAY)
+}
+
+impl SqliteEngine {
+    async fn history_source(
+        &self,
+        tx: &mut Transaction<'_, Sqlite>,
+        account: &str,
+        table: &str,
+    ) -> Result<TableDescription> {
+        let description = self.build_table_description_on(tx, account, table).await?;
+        if description.table_status != TableStatus::Active {
+            return Err(StorageError::TableNotActive(table.into()));
+        }
+        if description
+            .vector_indexes
+            .as_ref()
+            .is_some_and(|i| !i.is_empty())
+            || description.sse_description.is_some()
+            || description
+                .global_secondary_indexes
+                .as_ref()
+                .is_some_and(|i| i.iter().any(|i| i.index_status != "ACTIVE"))
+        {
+            return Err(unsupported());
+        }
+        Ok(description)
+    }
+
+    async fn history_user_source(
+        &self,
+        tx: &mut Transaction<'_, Sqlite>,
+        account: &str,
+        table: &str,
+    ) -> Result<TableDescription> {
+        let description = self.history_source(tx, account, table).await?;
+        let topology:bool=sqlx::query_scalar("SELECT EXISTS(SELECT 1 FROM sqlite_master WHERE type='table' AND name='lc_replication_topology')")
+            .fetch_one(&mut **tx).await.map_err(storage)?;
+        if topology {
+            let busy:bool=sqlx::query_scalar("SELECT EXISTS(SELECT 1 FROM lc_replication_topology WHERE table_id=? AND frozen=1 UNION ALL SELECT 1 FROM lc_replication_retired WHERE table_id=? UNION ALL SELECT 1 FROM lc_replication_reservations WHERE table_name=?)")
+                .bind(&description.table_id).bind(&description.table_id).bind(table).fetch_one(&mut **tx).await.map_err(storage)?;
+            if busy {
+                return Err(StorageError::IndexesInUse(
+                    "Replica lifecycle operation is in progress".into(),
+                ));
+            }
+        }
+        Ok(description)
+    }
+
+    pub(crate) async fn history_stage(
+        &self,
+        tx: &mut Transaction<'_, Sqlite>,
+        info: &TableKeyInfo,
+        key: &Item,
+        new: Option<&Item>,
+    ) -> Result<()> {
+        if !enabled(tx, &info.table_id).await? {
+            return Ok(());
+        }
+        let partition = info.key_schema.first().ok_or_else(unsupported)?;
+        let pk = pk_to_text(key.get(&partition.attribute_name).ok_or_else(unsupported)?)?;
+        let bytes =
+            if let Some((name, kind)) = sk_info(&info.key_schema, &info.attribute_definitions) {
+                match sk_bound(&parse_sk(key.get(name).ok_or_else(unsupported)?, kind)?) {
+                    BoundValue::Text(value) => value.into_bytes(),
+                    BoundValue::Blob(value) => value,
+                }
+            } else {
+                Vec::new()
+            };
+        let sk: String = sqlx::query_scalar("SELECT hex(?)")
+            .bind(bytes)
+            .fetch_one(&mut **tx)
+            .await
+            .map_err(storage)?;
+        let item = new
+            .map(serde_json::to_string)
+            .transpose()
+            .map_err(|e| StorageError::Internal(e.to_string()))?;
+        sqlx::query("INSERT INTO lc_pitr_pending VALUES(?,?,?,?) ON CONFLICT(table_id,pk,sk) DO UPDATE SET item_data=excluded.item_data")
+            .bind(&info.table_id).bind(pk.as_ref()).bind(sk).bind(item).execute(&mut **tx).await.map_err(storage)?;
+        Ok(())
+    }
+
+    pub(crate) async fn history_commit(&self, tx: &mut Transaction<'_, Sqlite>) -> Result<()> {
+        let pending: bool = sqlx::query_scalar("SELECT EXISTS(SELECT 1 FROM lc_pitr_pending)")
+            .fetch_one(&mut **tx)
+            .await
+            .map_err(storage)?;
+        if !pending {
+            return Ok(());
+        }
+        self.history_prune(tx, None).await?;
+        let at = commit_stamp(tx).await?;
+        sqlx::query(
+            "INSERT INTO lc_pitr_versions SELECT table_id,pk,sk,?,item_data FROM lc_pitr_pending",
+        )
+        .bind(at)
+        .execute(&mut **tx)
+        .await
+        .map_err(storage)?;
+        sqlx::query("DELETE FROM lc_pitr_pending")
+            .execute(&mut **tx)
+            .await
+            .map_err(storage)?;
+        Ok(())
+    }
+
+    pub(crate) async fn history_prune(
+        &self,
+        tx: &mut Transaction<'_, Sqlite>,
+        table: Option<&str>,
+    ) -> Result<()> {
+        let now = checked_now(tx).await?;
+        sqlx::query(
+            "UPDATE lc_pitr_windows SET floor_us=MAX(floor_us,started_us,?-days*86400000000) WHERE table_id=? OR (? IS NULL AND table_id IN (SELECT table_id FROM lc_pitr_pending))",
+        )
+        .bind(now)
+        .bind(table)
+        .bind(table)
+        .execute(&mut **tx)
+        .await
+        .map_err(storage)?;
+        sqlx::query("DELETE FROM lc_pitr_versions WHERE rowid IN (SELECT old.rowid FROM lc_pitr_versions old JOIN lc_pitr_windows w USING(table_id) WHERE (w.table_id=? OR (? IS NULL AND w.table_id IN (SELECT table_id FROM lc_pitr_pending))) AND old.at_us<w.floor_us AND (EXISTS(SELECT 1 FROM lc_pitr_versions newer WHERE newer.table_id=old.table_id AND newer.pk=old.pk AND newer.sk=old.sk AND newer.at_us>old.at_us AND newer.at_us<=w.floor_us) OR (old.item_data IS NULL AND NOT EXISTS(SELECT 1 FROM lc_pitr_versions older WHERE older.table_id=old.table_id AND older.pk=old.pk AND older.sk=old.sk AND older.at_us<old.at_us))) LIMIT 128)")
+            .bind(table).bind(table).execute(&mut **tx).await.map_err(storage)?;
+        sqlx::query("DELETE FROM backup_items WHERE rowid IN (SELECT i.rowid FROM backup_items i JOIN lc_backup_retention r USING(backup_arn) WHERE r.expires_us<=? LIMIT 128)").bind(now).execute(&mut **tx).await.map_err(storage)?;
+        sqlx::query("DELETE FROM backups WHERE backup_arn IN (SELECT r.backup_arn FROM lc_backup_retention r WHERE r.expires_us<=? AND NOT EXISTS(SELECT 1 FROM backup_items i WHERE i.backup_arn=r.backup_arn) LIMIT 1)").bind(now).execute(&mut **tx).await.map_err(storage)?;
+        Ok(())
+    }
+
+    pub async fn pitr_describe(&self, account: &str, table: &str) -> Result<Value> {
+        let mut tx = self.pool.begin().await.map_err(storage)?;
+        let id: String =
+            sqlx::query_scalar("SELECT table_id FROM tables WHERE account_id=? AND table_name=?")
+                .bind(account)
+                .bind(table)
+                .fetch_optional(&mut *tx)
+                .await
+                .map_err(storage)?
+                .ok_or_else(|| StorageError::TableNotFound(table.into()))?;
+        let recovery = match window(&mut tx, &id).await?.filter(|w| w.enabled) {
+            Some(window) => {
+                let now = checked_now(&mut tx).await?;
+                json!({"PointInTimeRecoveryStatus":"ENABLED","RecoveryPeriodInDays":window.days,"EarliestRestorableDateTime":seconds(floor(&window,now)),"LatestRestorableDateTime":seconds(now)})
+            }
+            None => json!({"PointInTimeRecoveryStatus":"DISABLED"}),
+        };
+        Ok(
+            json!({"ContinuousBackupsDescription":{"ContinuousBackupsStatus":"ENABLED","PointInTimeRecoveryDescription":recovery}}),
+        )
+    }
+
+    pub async fn pitr_configure(
+        &self,
+        account: &str,
+        table: &str,
+        enabled: bool,
+        days: Option<u32>,
+    ) -> Result<Value> {
+        if days.is_some_and(|days| !(1..=35).contains(&days)) {
+            return Err(StorageError::Validation(
+                "RecoveryPeriodInDays must be between 1 and 35".into(),
+            ));
+        }
+        {
+            let _writer = self.write_lock.lock().await;
+            let mut tx = self
+                .pool
+                .begin_with("BEGIN IMMEDIATE")
+                .await
+                .map_err(storage)?;
+            let description = self.history_user_source(&mut tx, account, table).await?;
+            let old = window(&mut tx, &description.table_id).await?;
+            let days = days
+                .map(i64::from)
+                .or_else(|| old.as_ref().map(|w| w.days))
+                .unwrap_or(35);
+            let now = checked_now(&mut tx).await?;
+            let reset = enabled && !old.as_ref().is_some_and(|w| w.enabled);
+            if reset {
+                sqlx::query("DELETE FROM lc_pitr_windows WHERE table_id=?")
+                    .bind(&description.table_id)
+                    .execute(&mut *tx)
+                    .await
+                    .map_err(storage)?;
+                let at = commit_stamp(&mut tx).await?;
+                sqlx::query("INSERT INTO lc_pitr_windows VALUES(?,?,?,1,?,?,?)")
+                    .bind(&description.table_id)
+                    .bind(account)
+                    .bind(table)
+                    .bind(at)
+                    .bind(at)
+                    .bind(days)
+                    .execute(&mut *tx)
+                    .await
+                    .map_err(storage)?;
+                let sk = sk_info(&description.key_schema, &description.attribute_definitions)
+                    .map(|(_, kind)| format!("hex(CAST({} AS BLOB))", sk_column(kind)))
+                    .unwrap_or_else(|| "''".into());
+                let source = data_table_name(&description.table_id);
+                sqlx::query(&format!(
+                    "INSERT INTO lc_pitr_versions SELECT ?,pk,{sk},?,item_data FROM {source}"
+                ))
+                .bind(&description.table_id)
+                .bind(at)
+                .execute(&mut *tx)
+                .await
+                .map_err(storage)?;
+            } else {
+                let started = old.as_ref().map(|w| w.started_us).unwrap_or(now);
+                let floor = old
+                    .as_ref()
+                    .map(|w| w.floor_us)
+                    .unwrap_or(now)
+                    .max(started)
+                    .max(now - days * DAY);
+                sqlx::query("INSERT INTO lc_pitr_windows VALUES(?,?,?,?,?,?,?) ON CONFLICT(table_id) DO UPDATE SET enabled=excluded.enabled,floor_us=excluded.floor_us,days=excluded.days")
+                    .bind(&description.table_id).bind(account).bind(table).bind(enabled).bind(started).bind(floor).bind(days).execute(&mut *tx).await.map_err(storage)?;
+            }
+            if !enabled {
+                sqlx::query("DELETE FROM lc_pitr_versions WHERE table_id=?")
+                    .bind(&description.table_id)
+                    .execute(&mut *tx)
+                    .await
+                    .map_err(storage)?;
+                sqlx::query("DELETE FROM lc_pitr_pending WHERE table_id=?")
+                    .bind(&description.table_id)
+                    .execute(&mut *tx)
+                    .await
+                    .map_err(storage)?;
+            }
+            self.history_prune(&mut tx, Some(&description.table_id))
+                .await?;
+            tx.commit().await.map_err(storage)?;
+        }
+        self.pitr_describe(account, table).await
+    }
+
+    pub async fn pitr_restore(
+        &self,
+        account: &str,
+        source: &str,
+        target: &str,
+        at: Option<f64>,
+    ) -> Result<Value> {
+        let arn = {
+            let _writer = self.write_lock.lock().await;
+            let mut tx = self
+                .pool
+                .begin_with("BEGIN IMMEDIATE")
+                .await
+                .map_err(storage)?;
+            let exists: bool = sqlx::query_scalar(
+                "SELECT EXISTS(SELECT 1 FROM tables WHERE account_id=? AND table_name=?)",
+            )
+            .bind(account)
+            .bind(target)
+            .fetch_one(&mut *tx)
+            .await
+            .map_err(storage)?;
+            if exists {
+                return Err(StorageError::TableAlreadyExists(target.into()));
+            }
+            let description = self.history_user_source(&mut tx, account, source).await?;
+            let window = window(&mut tx, &description.table_id)
+                .await?
+                .filter(|w| w.enabled)
+                .ok_or_else(unavailable)?;
+            let now = checked_now(&mut tx).await?;
+            let requested = restore_time(at, now, floor(&window, now))?;
+            let backup = self
+                .snapshot_on(
+                    &mut tx,
+                    account,
+                    source,
+                    "__pitr_restore__",
+                    SnapshotData::Historical(requested),
+                    "INTERNAL",
+                    Some(now + DAY),
+                )
+                .await?;
+            sqlx::query("INSERT INTO lc_pitr_restore_requests VALUES(?,?,?)")
+                .bind(&backup.backup_arn)
+                .bind(&description.table_arn)
+                .bind(requested)
+                .execute(&mut *tx)
+                .await
+                .map_err(storage)?;
+            tx.commit().await.map_err(storage)?;
+            backup.backup_arn
+        };
+        if let Err(error) = self.restore_table_from_backup(account, target, &arn).await {
+            self.delete_backup(account, &arn).await?;
+            return Err(error);
+        }
+        let description = self.build_table_description(account, target).await?;
+        Ok(json!({"TableDescription":description}))
+    }
+
+    pub(crate) async fn history_before_delete(
+        &self,
+        tx: &mut Transaction<'_, Sqlite>,
+        account: &str,
+        table: &str,
+        id: &str,
+    ) -> Result<()> {
+        if window(tx, id).await?.is_some_and(|w| w.enabled) {
+            let source = self.history_source(tx, account, table).await?;
+            if source.table_id != id {
+                return Err(StorageError::TableNotFound(table.into()));
+            }
+            let now = checked_now(tx).await?;
+            const SUFFIX: &str = "$DeletedTableBackup";
+            let prefix = table
+                .get(..table.len().min(255 - SUFFIX.len()))
+                .ok_or_else(unsupported)?;
+            let name = format!("{prefix}{SUFFIX}");
+            self.snapshot_on(
+                tx,
+                account,
+                table,
+                &name,
+                SnapshotData::Current,
+                "SYSTEM",
+                Some(now + 35 * DAY),
+            )
+            .await?;
+        }
+        sqlx::query("DELETE FROM lc_pitr_windows WHERE table_id=?")
+            .bind(id)
+            .execute(&mut **tx)
+            .await
+            .map_err(storage)?;
+        Ok(())
+    }
+
+    pub(crate) async fn history_refuse_vector_update(
+        &self,
+        tx: &mut Transaction<'_, Sqlite>,
+        id: &str,
+    ) -> Result<()> {
+        if window(tx, id).await?.is_some_and(|w| w.enabled) {
+            return Err(unsupported());
+        }
+        Ok(())
+    }
+}
