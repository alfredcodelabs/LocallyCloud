+            serde_json::from_value(json!({"TableName":"deletion-source"})).unwrap();
+        engine.delete_table_impl(ACCOUNT, input).await.unwrap();
+        let backups = engine
+            .list_backup_page_typed(ACCOUNT, None, "", None, None, 100, Some("SYSTEM"))
+            .await
+            .unwrap();
+        assert_eq!(backups.len(), 1);
+        let arn = &backups[0].backup_arn;
+        assert_eq!(backups[0].backup_type, "SYSTEM");
+        assert_eq!(backups[0].backup_name, "deletion-source$DeletedTableBackup");
+        assert!(
+            engine.backup_expiry(ACCOUNT, arn).await.unwrap().unwrap()
+                > seconds(now_us().unwrap() + 34 * DAY)
+        );
+        engine
+            .restore_table_from_backup(ACCOUNT, "system-restored", arn)
+            .await
+            .unwrap();
+        let restored = engine
+            .table_key_info(ACCOUNT, "system-restored")
+            .await
+            .unwrap();
+        assert_eq!(
+            engine.get_item(&restored, &key("key")).await.unwrap(),
+            Some(item("key", "latest-before-delete"))
+        );
+        let replacement = table(&engine, "deletion-source").await;
+        assert_ne!(replacement.table_id, info.table_id);
+        assert_eq!(
+            engine
+                .pitr_describe(ACCOUNT, "deletion-source")
+                .await
+                .unwrap()["ContinuousBackupsDescription"]["PointInTimeRecoveryDescription"]["PointInTimeRecoveryStatus"],
+            "DISABLED"
+        );
+        sqlx::query("UPDATE lc_backup_retention SET expires_us=0 WHERE backup_arn=?")
+            .bind(arn)
+            .execute(&engine.pool)
+            .await
+            .unwrap();
+        assert!(engine.backup_kind(ACCOUNT, arn).await.is_err());
+        assert!(
+            engine
+                .restore_table_from_backup(ACCOUNT, "expired-target", arn)
+                .await
+                .is_err()
+        );
+        assert!(
+            engine
+                .list_backup_page_typed(ACCOUNT, None, "", None, None, 100, Some("SYSTEM"))
+                .await
+                .unwrap()
+                .is_empty()
+        );
+    }
+}
