+#[cfg(test)]
+mod compound_key_tests {
+    use super::*;
+    use extenddb_core::expression::ExpressionMaps;
+    use extenddb_core::types::CreateTableInput;
+    use extenddb_storage::{DataEngine, TableEngine};
+
+    #[tokio::test]
+    async fn numeric_and_binary_sort_keys_share_baseline_and_mutation_identity() {
+        for (kind, sort) in [("N", json!({"N":"1.00"})), ("B", json!({"B":"AAEC"}))] {
+            let engine = SqliteEngine::new(":memory:", 1, "us-east-1", 409_600)
+                .await
+                .unwrap();
+            crate::schema::apply(&engine.pool).await.unwrap();
+            sqlx::query(
+                "INSERT INTO accounts(account_id,account_name) VALUES('000000000000','default')",
+            )
+            .execute(&engine.pool)
+            .await
+            .unwrap();
+            sqlx::query("INSERT OR REPLACE INTO settings(key,value) VALUES('control_plane_delay_seconds','0')").execute(&engine.pool).await.unwrap();
+            let input:CreateTableInput=serde_json::from_value(json!({"TableName":"compound-source","BillingMode":"PAY_PER_REQUEST","KeySchema":[{"AttributeName":"pk","KeyType":"HASH"},{"AttributeName":"sk","KeyType":"RANGE"}],"AttributeDefinitions":[{"AttributeName":"pk","AttributeType":"S"},{"AttributeName":"sk","AttributeType":kind}]})).unwrap();
+            engine
+                .create_table_impl("000000000000", input, false)
+                .await
+                .unwrap();
+            let info = engine
+                .table_key_info("000000000000", "compound-source")
+                .await
+                .unwrap();
+            let before: Item = serde_json::from_value(
+                json!({"pk":{"S":"key"},"sk":sort,"payload":{"S":"baseline"}}),
+            )
+            .unwrap();
+            let after: Item = serde_json::from_value(
+                json!({"pk":{"S":"key"},"sk":sort,"payload":{"S":"changed"}}),
+            )
+            .unwrap();
+            let key: Item = serde_json::from_value(json!({"pk":{"S":"key"},"sk":sort})).unwrap();
+            engine
+                .put_item(&info, before, false, None, &ExpressionMaps::default(), None)
+                .await
+                .unwrap();
+            engine
+                .pitr_configure("000000000000", "compound-source", true, None)
+                .await
+                .unwrap();
+            engine
+                .put_item(
+                    &info,
+                    after.clone(),
+                    false,
+                    None,
+                    &ExpressionMaps::default(),
+                    None,
+                )
+                .await
+                .unwrap();
+            let (rows, identities): (i64, i64) =
+                sqlx::query_as("SELECT COUNT(*),COUNT(DISTINCT sk) FROM lc_pitr_versions")
+                    .fetch_one(&engine.pool)
+                    .await
+                    .unwrap();
+            assert_eq!(
+                (rows, identities),
+                (2, 1),
+                "canonical sort key must match baseline and mutation"
+            );
+            engine
+                .pitr_restore("000000000000", "compound-source", "compound-restored", None)
+                .await
+                .unwrap();
+            let restored = engine
+                .table_key_info("000000000000", "compound-restored")
+                .await
+                .unwrap();
+            assert_eq!(engine.get_item(&restored, &key).await.unwrap(), Some(after));
+        }
+    }
+}
