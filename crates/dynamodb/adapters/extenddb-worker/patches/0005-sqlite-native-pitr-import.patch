diff --git a/crates/storage-sqlite/src/native_history.rs b/crates/storage-sqlite/src/native_history.rs
new file mode 100644
--- /dev/null
+++ b/crates/storage-sqlite/src/native_history.rs
@@ -0,0 +1,283 @@
+// Copyright 2026 LocalCloud contributors
+// SPDX-License-Identifier: Apache-2.0
+
+//! Offline import preserves native timestamp bits; ordinary PITR still owns restore/indexing.
+use extenddb_core::types::{
+    AttributeValue, Item, KeyType, ScalarAttributeType, TableDescription, item_size_bytes,
+};
+use extenddb_storage::error::StorageError;
+use extenddb_storage::util::{parse_sk, pk_to_text, sk_info};
+use serde_json::{Value, json};
+use sqlx::{Sqlite, Transaction};
+
+use crate::data::{BoundValue, sk_bound};
+use crate::history::{now_us, seconds, storage};
+use crate::store::SqliteEngine;
+
+type Result<T> = std::result::Result<T, StorageError>;
+fn invalid() -> StorageError {
+    StorageError::Validation("Invalid native recovery history or conflicting import".into())
+}
+
+pub(crate) async fn earliest(
+    tx: &mut Transaction<'_, Sqlite>,
+    id: &str,
+    floor: f64,
+) -> Result<f64> {
+    let start: Option<f64> =
+        sqlx::query_scalar("SELECT started FROM lc_pitr_native_windows WHERE table_id=?")
+            .bind(id)
+            .fetch_optional(&mut **tx)
+            .await
+            .map_err(storage)?;
+    Ok(start.map_or(floor, |start| floor.max(start)))
+}
+
+async fn key(
+    tx: &mut Transaction<'_, Sqlite>,
+    desc: &TableDescription,
+    key: &Item,
+) -> Result<(String, String)> {
+    if key.len() != desc.key_schema.len() {
+        return Err(invalid());
+    }
+    for field in &desc.key_schema {
+        let value = key.get(&field.attribute_name).ok_or_else(invalid)?;
+        let kind = desc
+            .attribute_definitions
+            .iter()
+            .find(|d| d.attribute_name == field.attribute_name)
+            .map(|d| d.attribute_type)
+            .ok_or_else(invalid)?;
+        if !matches!(
+            (kind, value),
+            (ScalarAttributeType::S, AttributeValue::S(_))
+                | (ScalarAttributeType::N, AttributeValue::N(_))
+                | (ScalarAttributeType::B, AttributeValue::B(_))
+        ) {
+            return Err(invalid());
+        }
+    }
+    let partition = desc
+        .key_schema
+        .iter()
+        .find(|k| k.key_type == KeyType::Hash)
+        .ok_or_else(invalid)?;
+    let pk = pk_to_text(key.get(&partition.attribute_name).ok_or_else(invalid)?)?.into_owned();
+    let bytes = if let Some((name, kind)) = sk_info(&desc.key_schema, &desc.attribute_definitions) {
+        match sk_bound(&parse_sk(key.get(name).ok_or_else(invalid)?, kind)?) {
+            BoundValue::Text(text) => text.into_bytes(),
+            BoundValue::Blob(bytes) => bytes,
+        }
+    } else {
+        Vec::new()
+    };
+    let sk: String = sqlx::query_scalar("SELECT hex(?)")
+        .bind(bytes)
+        .fetch_one(&mut **tx)
+        .await
+        .map_err(storage)?;
+    Ok((pk, sk))
+}
+
+impl SqliteEngine {
+    pub async fn native_history_begin(
+        &self,
+        account: &str,
+        table: &str,
+        enabled: bool,
+        started: f64,
+        latest: f64,
+        days: u32,
+    ) -> Result<Value> {
+        let now = seconds(now_us()?);
+        if !started.is_finite()
+            || !latest.is_finite()
+            || started < 0.0
+            || latest < started
+            || latest > now
+            || !(1..=35).contains(&days)
+        {
+            return Err(invalid());
+        }
+        let _writer = self.write_lock.lock().await;
+        let mut tx = self
+            .pool
+            .begin_with("BEGIN IMMEDIATE")
+            .await
+            .map_err(storage)?;
+        let desc = self.history_user_source(&mut tx, account, table).await?;
+        let exists: bool =
+            sqlx::query_scalar("SELECT EXISTS(SELECT 1 FROM lc_pitr_windows WHERE table_id=?)")
+                .bind(&desc.table_id)
+                .fetch_one(&mut *tx)
+                .await
+                .map_err(storage)?;
+        if exists {
+            return Err(invalid());
+        }
+        // Existing workers validate this scope exactly and must not ignore imported history.
+        let scope = format!("{account}:{}", self.region);
+        let upgraded = format!("{scope}:migration-history-v1");
+        let stored: Option<String> =
+            sqlx::query_scalar("SELECT value FROM settings WHERE key='locallycloud_scope'")
+                .fetch_optional(&mut *tx)
+                .await
+                .map_err(storage)?;
+        match stored.as_deref() {
+            Some(value) if value == scope => {
+                sqlx::query("UPDATE settings SET value=? WHERE key='locallycloud_scope'")
+                    .bind(upgraded)
+                    .execute(&mut *tx)
+                    .await
+                    .map_err(storage)?;
+            }
+            Some(value) if value == upgraded => {}
+            _ => return Err(invalid()),
+        }
+        // Only the ordinary clock/window is rounded outward; source versions retain f64 seconds.
+        #[allow(clippy::cast_possible_truncation)]
+        let floor = (started * 1_000_000.0).floor() as i64;
+        #[allow(clippy::cast_possible_truncation)]
+        let clock = (latest * 1_000_000.0).ceil() as i64;
+        sqlx::query("INSERT INTO lc_pitr_windows VALUES(?,?,?,?,?,?,?)")
+            .bind(&desc.table_id)
+            .bind(account)
+            .bind(table)
+            .bind(enabled)
+            .bind(floor)
+            .bind(floor)
+            .bind(i64::from(days))
+            .execute(&mut *tx)
+            .await
+            .map_err(storage)?;
+        sqlx::query("INSERT INTO lc_pitr_native_windows VALUES(?,?,?,?,?)")
+            .bind(&desc.table_id)
+            .bind(enabled)
+            .bind(started)
+            .bind(latest)
+            .bind(i64::from(days))
+            .execute(&mut *tx)
+            .await
+            .map_err(storage)?;
+        sqlx::query("UPDATE lc_pitr_clock SET last_us=MAX(last_us,?) WHERE singleton=1")
+            .bind(clock)
+            .execute(&mut *tx)
+            .await
+            .map_err(storage)?;
+        tx.commit().await.map_err(storage)?;
+        self.native_history_describe(account, table).await
+    }
+
+    pub async fn native_history_put(
+        &self,
+        account: &str,
+        table: &str,
+        at: f64,
+        source_key: &Item,
+        item: Option<&Item>,
+    ) -> Result<Value> {
+        if !at.is_finite() || at < 0.0 || item.is_some_and(|item| item_size_bytes(item) > 409_600) {
+            return Err(invalid());
+        }
+        let _writer = self.write_lock.lock().await;
+        let mut tx = self
+            .pool
+            .begin_with("BEGIN IMMEDIATE")
+            .await
+            .map_err(storage)?;
+        let desc = self.history_user_source(&mut tx, account, table).await?;
+        let latest: f64 =
+            sqlx::query_scalar("SELECT latest FROM lc_pitr_native_windows WHERE table_id=?")
+                .bind(&desc.table_id)
+                .fetch_optional(&mut *tx)
+                .await
+                .map_err(storage)?
+                .ok_or_else(invalid)?;
+        if at > latest {
+            return Err(invalid());
+        }
+        let (pk, sk) = key(&mut tx, &desc, source_key).await?;
+        if let Some(item) = item {
+            let item_key = desc
+                .key_schema
+                .iter()
+                .map(|field| {
+                    item.get(&field.attribute_name)
+                        .map(|value| (field.attribute_name.clone(), value.clone()))
+                        .ok_or_else(invalid)
+                })
+                .collect::<Result<Item>>()?;
+            if key(&mut tx, &desc, &item_key).await? != (pk.clone(), sk.clone()) {
+                return Err(invalid());
+            }
+        }
+        let encoded = item
+            .map(serde_json::to_string)
+            .transpose()
+            .map_err(|_| invalid())?;
+        let previous: Option<(Option<String>,)> = sqlx::query_as("SELECT item_data FROM lc_pitr_native_versions WHERE table_id=? AND pk=? AND sk=? AND at=?")
+            .bind(&desc.table_id).bind(&pk).bind(&sk).bind(at).fetch_optional(&mut *tx).await.map_err(storage)?;
+        if let Some((old,)) = previous {
+            if old != encoded {
+                return Err(invalid());
+            }
+        } else {
+            sqlx::query("INSERT INTO lc_pitr_native_versions VALUES(?,?,?,?,?)")
+                .bind(&desc.table_id)
+                .bind(pk)
+                .bind(sk)
+                .bind(at)
+                .bind(encoded)
+                .execute(&mut *tx)
+                .await
+                .map_err(storage)?;
+        }
+        tx.commit().await.map_err(storage)?;
+        Ok(json!({}))
+    }
+
+    pub async fn native_history_get(
+        &self,
+        account: &str,
+        table: &str,
+        at: f64,
+        source_key: &Item,
+    ) -> Result<Value> {
+        if !at.is_finite() || at < 0.0 {
+            return Err(invalid());
+        }
+        let mut tx = self.pool.begin().await.map_err(storage)?;
+        let desc = self.history_user_source(&mut tx, account, table).await?;
+        let (pk, sk) = key(&mut tx, &desc, source_key).await?;
+        let (item,): (Option<String>,) = sqlx::query_as("SELECT item_data FROM lc_pitr_native_versions WHERE table_id=? AND pk=? AND sk=? AND at=?")
+            .bind(&desc.table_id).bind(pk).bind(sk).bind(at).fetch_optional(&mut *tx).await.map_err(storage)?
+            .ok_or_else(|| StorageError::TableNotFound("Native history record does not exist".into()))?;
+        let item = item
+            .map(|item| serde_json::from_str::<Value>(&item).map_err(|_| invalid()))
+            .transpose()?;
+        Ok(json!({"Item":item}))
+    }
+
+    pub async fn native_history_describe(&self, account: &str, table: &str) -> Result<Value> {
+        let mut tx = self.pool.begin().await.map_err(storage)?;
+        let desc = self.history_user_source(&mut tx, account, table).await?;
+        let (enabled, started, latest, days): (bool, f64, f64, i64) = sqlx::query_as(
+            "SELECT enabled,started,latest,days FROM lc_pitr_native_windows WHERE table_id=?",
+        )
+        .bind(&desc.table_id)
+        .fetch_optional(&mut *tx)
+        .await
+        .map_err(storage)?
+        .ok_or_else(invalid)?;
+        let count: i64 =
+            sqlx::query_scalar("SELECT COUNT(*) FROM lc_pitr_native_versions WHERE table_id=?")
+                .bind(&desc.table_id)
+                .fetch_one(&mut *tx)
+                .await
+                .map_err(storage)?;
+        Ok(
+            json!({"Enabled":enabled,"Started":started,"Latest":latest,"Days":days,"VersionCount":count}),
+        )
+    }
+}
